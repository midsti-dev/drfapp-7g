---
# ПРИМЕР файла с секретами
# Скопируй в secret.yaml и замени на реальные значения
# НЕ КОММИТЬ secret.yaml В GIT!
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: default
type: Opaque
stringData:
  # Django SECRET_KEY
  SECRET_KEY: "CHANGE-ME-your-django-secret-key-here"

  # Database password
  DB_PASSWORD: "CHANGE-ME-your-postgres-password"

  # Другие секреты при необходимости
  # AWS_SECRET_ACCESS_KEY: "your-aws-secret"
  # SMTP_PASSWORD: "your-smtp-password"